# Copy to .env.local. Server-side only (no VITE_ prefix) so nothing here reaches the browser bundle.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
# Optional tab names (defaults shown)
GUEST_SHEET_NAME=khách mời
RSVP_SHEET_NAME=Responses

# Docker (VM): cổng mở ra máy chủ VM (mặc định 3000).
APP_PORT=3000
# Số proxy tin cậy đứng trước ứng dụng (Kong = 1). Dùng để lấy đúng IP khách khi chống spam RSVP.
# Đặt 0 nếu ứng dụng được truy cập trực tiếp, không qua proxy.
TRUSTED_PROXY_HOPS=1

# Địa chỉ công khai của trang, dùng cho ảnh và liên kết khi chia sẻ lên Zalo, Facebook, Messenger.
SITE_URL=https://wedding.hson.io.vn
